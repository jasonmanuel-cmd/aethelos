# ============================================================
# FSOS - Environment Configuration
# ============================================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fsos
DB_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# API
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# OpenAI (for AI Scoring Engine)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Twilio (for SMS Automation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# Email (for Email Automation)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@fsos.io
EMAIL_FROM_NAME=FSOS

# Encryption (for sensitive PII)
ENCRYPTION_KEY=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
